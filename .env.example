DATABASE_URL=postgresql://user:password@host:5432/smm_panel?sslmode=require
JWT_SECRET=replace-with-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
ONEXPANEL_API_URL=https://1xpanel.com/api/v2
ONEXPANEL_API_KEY=replace-with-1xpanel-api-key
ONEXPANEL_TIMEOUT_SECONDS=5
ONEXPANEL_SERVICES_CACHE_TTL=300
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SSL_CERT_FILE=
ENABLE_DEBUG_ENDPOINTS=false
